#!/bin/sh
# ============================================
# TECHIZAT OS - live-build config script
# Bu dosya "lb config" u dogru parametrelerle calistirir.
# build-iso.sh bunu otomatik cagirir, elle calistirmana gerek yok.
#
# Onceden bu dosya HIC YOKTU -> lb config hic calismiyordu ->
# chroot icine kernel / live-boot / live-config hic kurulmuyordu ->
# ISO icinde /live/vmlinuz olusmuyordu -> GRUB "vmlinuz not found" hatasi.
# ============================================

set -e

# Parrot rolling bir dagitim, kod adi zamanla degisir (ornegin "lory").
# Build makinesinin KENDI kod adini kullanmak en guvenlisi.
CODENAME="$(lsb_release -cs 2>/dev/null || true)"
if [ -z "$CODENAME" ]; then
	CODENAME="$(. /etc/os-release 2>/dev/null; echo "$VERSION_CODENAME")"
fi
if [ -z "$CODENAME" ]; then
	echo "[!] Parrot kod adi tespit edilemedi, elle CODENAME degiskenini ayarla." >&2
	exit 1
fi
echo "[*] Tespit edilen dagitim kod adi: $CODENAME"

lb config noauto \
	--distribution "$CODENAME" \
	--parent-distribution "$CODENAME" \
	--archive-areas "main contrib non-free non-free-firmware" \
	--parent-archive-areas "main contrib non-free non-free-firmware" \
	--mirror-bootstrap "https://deb.parrot.sh/parrot" \
	--mirror-binary "https://deb.parrot.sh/parrot" \
	--mirror-chroot "https://deb.parrot.sh/parrot" \
	--mirror-chroot-security "https://deb.parrot.sh/parrot" \
	--mirror-binary-security "https://deb.parrot.sh/parrot" \
	--architectures amd64 \
	--binary-images iso-hybrid \
	--bootloaders grub-pc \
	--debian-installer none \
	--linux-packages "linux-image" \
	--updates true \
	--security true \
	"${@}"
